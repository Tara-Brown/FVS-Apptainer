From: ubuntu:latest

%post
    # Update package lists and install required packages
    apt-get update && apt-get install -y \
        git \
        wget \
        locales \
        curl \
        build-essential \
        bzip2 \
        && rm -rf /var/lib/apt/lists/*
        #language settings
        locale-gen en_US.UTF-8

    #Download and install rust
    curl https://sh.rustup.rs -sSf | sh -s -- -y
    export PATH=/root/.cargo/bin:$PATH

    # Download and install Anaconda
    wget https://repo.anaconda.com/archive/Anaconda3-2022.05-Linux-x86_64.sh -O /tmp/anaconda.sh
    bash /tmp/anaconda.sh -b -p /opt/conda
    rm /tmp/anaconda.sh

%environment
    # Set up environment variables / dependencies
    export PATH=/opt/conda/envs/Test/bin:/root/.cargo/bin:export:/tmp/target/release:$PATH
    . /opt/conda/etc/profile.d/conda.sh
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    conda env create -f environment.yml
    conda activate Test
    # For dealing with remote servers using BEEGFS. Relocates cargo.
    export CARGO_TARGET_DIR=/tmp/target
%runscript
# Ensure Cargo build is only run when necessary
if [ ! -f /tmp/target/release/assembly_graph_generator ]; then
    echo "Building rust files..."
    cargo build --release
else
    echo "Cargo build already exists, skipping compilation."
fi

# Symlink all rust directories in current repository to where the rust files are built
if [ ! -f $PWD/target/release/assembly_graph_generator ]; then
    ln -s /tmp/target/release/assembly_graph_generator $PWD/target/release/assembly_graph_generator
    ln -s /tmp/target/release/graph_analyzer $PWD/target/release/graph_analyzer
    ln -s /tmp/target/release/super_source_and_sink $PWD/target/release/super_source_and_sink
    echo "Symlinked rust build to directory."
else
    echo "Symlink already exists."
fi
    exec "$@"

